{
  "name": "honcho-dashboard",
  "version": "1.6.4",
  "description": "Self-hosted web inspector for the OSS Honcho server",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "svelte-kit sync && vite build && bun build src/server/index.ts --target=bun --outdir=dist --minify",
    "preview": "vite preview",
    "start": "bun run dist/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:ui": "bun run build && playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:watch": "vitest",
    "codegen": "openapi-typescript src/lib/honcho/openapi.json -o src/lib/honcho/types.ts",
    "refresh-openapi": "./scripts/refresh-honcho-openapi.sh"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.3.5",
    "dompurify": "^3.4.17",
    "hono": "^4.13.13",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.3",
    "@types/dompurify": "^3.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "playwright-core": "^1.60.0"
  }
}
